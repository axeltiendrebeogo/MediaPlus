@@ -33,7 +33,58 @@
   border-bottom: 1px solid var(--color-border);
   padding: 60px 40px 0;
 }
-.hero-inner { max-width: 680px; margin: 0 auto; }
+.hero-grid {
+  max-width: 1160px;
+  margin: 0 auto;
+  display: grid;
+  grid-template-columns: minmax(0, 560px) minmax(0, 460px);
+  gap: 64px;
+  align-items: center;
+}
+.hero-inner { max-width: 560px; }
+
+/* Aperçu produit à droite du hero */
+.hero-visual { display: flex; justify-content: center; padding-bottom: 40px; }
+.hero-preview-card {
+  width: 100%;
+  max-width: 420px;
+  background: white;
+  border: 1px solid var(--color-border);
+  border-radius: 12px;
+  box-shadow: 0 20px 40px -20px rgba(0,0,0,.15);
+  overflow: hidden;
+}
+.hero-preview-header {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  padding: 12px 16px;
+  border-bottom: 1px solid var(--color-border);
+}
+.hero-preview-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-border); }
+.hero-preview-title { font-size: 12px; font-weight: 600; color: var(--color-text-secondary); margin-left: 8px; }
+.hero-preview-body { padding: 20px 16px; }
+.hero-preview-chart {
+  display: flex;
+  align-items: flex-end;
+  gap: 8px;
+  height: 100px;
+  margin-bottom: 20px;
+}
+.hero-bar { flex: 1; background: var(--color-primary-muted); border-radius: 4px 4px 0 0; }
+.hero-bar-active { background: var(--color-primary); }
+.hero-preview-rows { display: flex; flex-direction: column; gap: 10px; }
+.hero-preview-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  font-size: 13px;
+  padding: 8px 10px;
+  background: var(--color-bg);
+  border-radius: 8px;
+}
+.hero-preview-row-label { color: var(--color-text); font-weight: 500; }
+.hero-preview-row-value { font-weight: 700; }
 
 .hero-badge {
   display: inline-block;
