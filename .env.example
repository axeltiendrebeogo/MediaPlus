# ============================================================
# MediaPulse — Variables d'environnement (Back-end Django)
# Copier ce fichier en .env et renseigner les vraies valeurs.
# Ne JAMAIS committer le fichier .env (voir .gitignore).
# ============================================================

# --- Django ---
SECRET_KEY=django-insecure-change-moi-en-production
DEBUG=true

# --- Base de données ---
# Format: postgresql://user:password@host:port/nom_db
# En local sans Postgres installé, laisser vide pour retomber sur SQLite (dev uniquement).
DATABASE_URL=postgresql://mediapulse_user:motdepasse@localhost:5432/mediapulse_db

# --- CORS ---
# Origines autorisées séparées par des virgules
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- JWT ---
ACCESS_TOKEN_LIFETIME=15
REFRESH_TOKEN_LIFETIME=7

# --- Rapports PDF ---
PDF_STORAGE_PATH=media/rapports/

# --- Quota de génération de rapports ---
RAPPORTS_QUOTA_MAX=3
RAPPORTS_QUOTA_FENETRE_HEURES=4

# --- Timeout de génération de rapport (secondes) ---
RAPPORTS_TIMEOUT_SECONDES=120
